
:root {
  --green: #263b30;
  --cream: #f7f3eb;
  --gold: #bd9a60;
  --dark: #242820;
  --muted: #77796f;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--dark);
  font-family: Arial, sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

.announcement {
  background: var(--green);
  color: white;
  text-align: center;
  padding: 11px;
  font-size: 10px;
  letter-spacing: 2px;
}

.navbar {
  min-height: 82px;
  padding: 20px 7%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  background: var(--cream);
}

.logo {
  font-family: Georgia, serif;
  font-size: 23px;
  letter-spacing: 3px;
  white-space: nowrap;
}

.logo span {
  color: var(--gold);
}

nav {
  display: flex;
  gap: 28px;
  font-size: 12px;
}

nav a:hover {
  color: var(--gold);
}

.menu-toggle {
  display: none;
  background: none;
  border: 0;
  font-size: 25px;
  cursor: pointer;
}

.hero {
  min-height: 510px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: #eae5d9;
}

.hero-content {
  padding: 75px 10% 70px 14%;
  align-self: center;
}

.eyebrow {
  font-size: 10px;
  letter-spacing: 2.5px;
  color: #9b7845;
  font-weight: bold;
}

h1, h2, h3 {
  font-family: Georgia, "Times New Roman", serif;
  font-weight: normal;
}

h1 {
  font-size: clamp(42px, 5vw, 68px);
  line-height: 1.05;
  margin: 22px 0;
}

.hero-text {
  color: #62665d;
  line-height: 1.9;
  max-width: 350px;
  font-size: 14px;
  margin-bottom: 32px;
}

.button {
  display: inline-block;
  background: var(--green);
  color: white;
  padding: 17px 22px;
  font-size: 10px;
  letter-spacing: 1.5px;
  border: 1px solid var(--green);
  cursor: pointer;
  transition: background 0.2s;
}

.button:hover {
  background: #3d5948;
}

.hero-art {
  min-height: 400px;
  background: var(--green);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  position: relative;
  overflow: hidden;
}

.hero-circle {
  position: absolute;
  width: min(75%, 360px);
  aspect-ratio: 1;
  border: 1px solid #bd9a60;
  border-radius: 50%;
}

.hero-dog {
  position: relative;
  font-size: clamp(100px, 16vw, 190px);
  filter: saturate(0.7);
}

.hero-caption {
  position: relative;
  margin-top: 25px;
  color: #e5d2ac;
  font-size: 9px;
  letter-spacing: 3px;
}

.values {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 18px;
  padding: 24px 5%;
  border-bottom: 1px solid #e2dccf;
  font-family: Georgia, serif;
  font-size: 13px;
}

.section {
  padding: 85px 7%;
  text-align: center;
}

.section h2 {
  font-size: clamp(30px, 4vw, 43px);
  margin: 15px 0;
}

.section-intro {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 42px;
}

.products {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  text-align: left;
}

.product-card {
  min-width: 0;
}

.product-image {
  min-height: 260px;
  aspect-ratio: 4 / 4.5;
  display: flex;
  align-items: flex-start;
  justify-content: flex-end;
  padding: 16px;
}

.product-image span {
  color: var(--green);
  font-family: Georgia, serif;
  font-size: 13px;
}

.image-one {
  background: linear-gradient(145deg, #ded5c3, #b8a990);
}

.image-two {
  background: linear-gradient(145deg, #c6c7b6, #929b86);
}

.image-three {
  background: linear-gradient(145deg, #d9c9b3, #b69c79);
}

.product-info {
  display: flex;
  flex-direction: column;
  gap: 7px;
  padding: 15px 0;
}

.product-info h3 {
  font-size: 21px;
  margin: 0 0 8px;
}

.product-info p {
  font-size: 12px;
  margin: 0;
  color: var(--muted);
}

.product-info .price {
  color: var(--green);
  font-weight: bold;
}

.enquire {
  width: 100%;
  background: transparent;
  color: var(--green);
  border: 1px solid #bdb9aa;
  padding: 14px 8px;
  font-size: 10px;
  letter-spacing: 1px;
  cursor: pointer;
}

.enquire:hover {
  background: var(--green);
  color: white;
}

.note {
  font-size: 11px;
  line-height: 1.7;
  color: var(--muted);
}

.story {
  background: #e9e4d8;
}

.story > p:not(.eyebrow) {
  max-width: 580px;
  margin: 25px auto 0;
  color: #64675d;
  font-size: 14px;
  line-height: 2;
}

.contact {
  padding-top: 90px;
  padding-bottom: 90px;
}

.contact > p:not(.eyebrow):not(.note) {
  color: var(--muted);
  font-size: 13px;
  margin: 20px 0 28px;
}

.contact .note {
  margin-top: 20px;
}

footer {
  background: var(--green);
  color: white;
  text-align: center;
  padding: 40px 20px;
}

.footer-logo {
  display: inline-block;
  font-size: 20px;
}

footer p {
  font-size: 11px;
  line-height: 1.8;
  color: #d4d8ce;
}

@media (max-width: 700px) {
  .navbar {
    flex-wrap: wrap;
  }

  .menu-toggle {
    display: block;
  }

  nav {
    display: none;
    width: 100%;
    flex-direction: column;
    gap: 18px;
    padding: 12px 0;
  }

  nav.open {
    display: flex;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .hero-content {
    padding: 65px 8%;
  }

  .hero-art {
    min-height: 310px;
  }

  .values {
    flex-direction: column;
    align-items: center;
  }

  .section {
    padding: 60px 6%;
  }

  .products {
    grid-template-columns: 1fr;
    gap: 35px;
  }

  .product-image {
    aspect-ratio: 4 / 3;
  }
}
